<h1>MedSimAI Patient Builder</h1>

<%!-- Tab Navigation --%>
<div class="tabs">
  <button
    class={"tab #{if @active_tab == "create", do: "active"}"}
    phx-click="switch_tab"
    phx-value-tab="create"
  >
    Simple Patient
  </button>
  <button
    class={"tab #{if @active_tab == "workflow", do: "active"}"}
    phx-click="switch_tab"
    phx-value-tab="workflow"
  >
    Adaptive Patient
  </button>
  <button
    class={"tab #{if @active_tab == "existing", do: "active"}"}
    phx-click="switch_tab"
    phx-value-tab="existing"
  >
    Use Existing
  </button>
</div>

<%!-- Create Agent Tab --%>
<section id="create-tab" class={"tab-content #{if @active_tab == "create", do: "active"}"}>
  <h2>Create New Patient</h2>
  <form phx-submit="create_agent">
    <div class="form-group">
      <label for="agent_name">Patient Name</label>
      <input type="text" name="agent_name" id="agent_name" placeholder="My Custom Patient" />
    </div>

    <div class="form-group">
      <label for="agent_prompt">Patient History *</label>
      <textarea
        name="agent_prompt"
        id="agent_prompt"
        rows="6"
        placeholder="Patient history, medical history, medications, allergies, etc."
        required
      ></textarea>
    </div>

    <div class="form-group">
      <label for="first_message">Patient Goals (optional)</label>
      <input
        type="text"
        name="first_message"
        id="first_message"
        placeholder="Hello Doctor, What do you want?"
      />
    </div>

    <div class="form-group">
      <label for="voice_id">Voice</label>
      <div class="voice-select-wrapper">
        <select name="voice_id" id="voice_id">
          <%= for voice <- @voices do %>
            <option value={voice.voice_id}>
              <%= voice.name %> (<%= voice.category || "custom" %>)
            </option>
          <% end %>
        </select>
        <button
          type="button"
          class="btn-preview"
          id="preview-voice-btn"
          phx-hook="VoicePreview"
          data-select="voice_id"
          title="Preview voice"
        >
          &#9654;
        </button>
        <button
          type="button"
          class="btn-browse"
          phx-click="open_voice_library"
          phx-value-target="voice_id"
          title="Browse Voice Library"
        >
          &#128269;
        </button>
      </div>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label for="language">Language</label>
        <select name="language" id="language">
          <%= for {label, value} <- @languages do %>
            <option value={value}><%= label %></option>
          <% end %>
        </select>
      </div>
    </div>

    <button type="submit" id="create-agent-btn">Create Patient</button>
  </form>
</section>

<%!-- Adaptive Patient Designer Tab --%>
<section id="workflow-tab" class={"tab-content #{if @active_tab == "workflow", do: "active"}"}>
  <h2>Adaptive Patient Designer</h2>
  <p class="designer-intro">
    Create patients that respond dynamically based on how medical students treat them.
  </p>

  <form phx-submit="create_adaptive_patient">
    <%!-- Patient Case Section --%>
    <div class="designer-section">
      <h3>Patient Case</h3>
      <div class="form-row">
        <div class="form-group">
          <label for="patient_name">Patient Name *</label>
          <input
            type="text"
            name="patient_name"
            id="patient_name"
            placeholder="e.g., John Smith"
            value={@patient_name}
            required
          />
        </div>
        <div class="form-group form-group-small">
          <label for="patient_age">Age</label>
          <input
            type="number"
            name="patient_age"
            id="patient_age"
            placeholder="45"
            min="1"
            max="120"
            value={@patient_age}
          />
        </div>
        <div class="form-group form-group-small">
          <label for="patient_gender">Gender</label>
          <select name="patient_gender" id="patient_gender">
            <option value="male" selected={@patient_gender == "male"}>Male</option>
            <option value="female" selected={@patient_gender == "female"}>Female</option>
            <option value="other" selected={@patient_gender == "other"}>Other</option>
          </select>
        </div>
      </div>

      <div class="form-group">
        <label for="presenting_complaint">Presenting Complaint *</label>
        <input
          type="text"
          name="presenting_complaint"
          id="presenting_complaint"
          placeholder="e.g., Chest pain for 2 days"
          value={@presenting_complaint}
          required
        />
      </div>

      <div class="form-group">
        <label for="hidden_diagnosis">
          Hidden Diagnosis (what the student should discover)
        </label>
        <input
          type="text"
          name="hidden_diagnosis"
          id="hidden_diagnosis"
          placeholder="e.g., Anxiety-induced chest pain from work stress"
          value={@hidden_diagnosis}
        />
      </div>

      <div class="form-group">
        <label for="patient_voice">Voice</label>
        <div class="voice-select-wrapper">
          <select name="patient_voice" id="patient_voice">
            <option value="">Select a voice...</option>
            <%= for voice <- @voices do %>
              <option value={voice.voice_id}><%= voice.name %></option>
            <% end %>
          </select>
          <button
            type="button"
            class="btn-preview"
            phx-hook="VoicePreview"
            data-select="patient_voice"
            title="Preview voice"
          >
            &#9654;
          </button>
          <button
            type="button"
            class="btn-browse"
            phx-click="open_voice_library"
            phx-value-target="patient_voice"
            title="Browse Voice Library"
          >
            &#128269;
          </button>
        </div>
      </div>
    </div>

    <%!-- Initial Presentation Section --%>
    <div class="designer-section">
      <h3>Initial Presentation</h3>
      <p class="section-hint">How does the patient present when the conversation begins?</p>
      <div class="form-group">
        <label for="initial_presentation">Patient's Initial Behavior & Demeanor *</label>
        <textarea
          name="initial_presentation"
          id="initial_presentation"
          rows="4"
          placeholder="e.g., Anxious, clutching chest, speaks quickly, avoids eye contact..."
          required
        ><%= @initial_presentation %></textarea>
      </div>
      <div class="form-group">
        <label for="first_words">First Words (what patient says when encounter starts)</label>
        <input
          type="text"
          name="first_words"
          id="first_words"
          placeholder="e.g., Doctor, I've been having this chest pain..."
          value={@first_words}
        />
      </div>
    </div>

    <%!-- Behavioral Pivots Section --%>
    <div class="designer-section">
      <h3>Behavioral Pivots</h3>
      <p class="section-hint">
        Define how the patient responds based on the student's approach. The AI will evaluate these conditions during the conversation.
      </p>

      <div id="pivots-container">
        <%= for {pivot, index} <- Enum.with_index(@pivots) do %>
          <div class="pivot-card" data-pivot-id={"pivot-#{pivot.id}"}>
            <div class="pivot-header">
              <span class={"pivot-icon #{pivot.icon}"}>
                <%= case pivot.icon do %>
                  <% "good" -> %>
                    &#10004;
                  <% "bad" -> %>
                    &#10008;
                  <% _ -> %>
                    ?
                <% end %>
              </span>
              <span class="pivot-title"><%= pivot.title %></span>
              <input type="hidden" name={"pivot_title_#{index}"} value={pivot.title} />
              <button
                type="button"
                class="pivot-remove"
                phx-click="remove_pivot"
                phx-value-id={pivot.id}
                title="Remove pivot"
              >
                &times;
              </button>
            </div>
            <div class="pivot-body">
              <div class="form-group">
                <label>Trigger Condition</label>
                <textarea
                  class="pivot-condition"
                  name={"pivot_condition_#{index}"}
                  rows="2"
                  placeholder="What student behavior triggers this response?"
                ><%= pivot.condition %></textarea>
              </div>
              <div class="form-group">
                <label>Patient Response</label>
                <textarea
                  class="pivot-response"
                  name={"pivot_response_#{index}"}
                  rows="3"
                  placeholder="How does the patient respond?"
                ><%= pivot.response %></textarea>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <button type="button" class="btn-secondary btn-add" phx-click="add_pivot">
        + Add Another Behavioral Pivot
      </button>
    </div>

    <%!-- Preview Section --%>
    <div class="designer-section preview-section">
      <h3>Workflow Preview</h3>
      <div id="workflow-preview" class="workflow-preview">
        <div class="preview-node preview-start">Start</div>
        <div class="preview-arrow">&rarr;</div>
        <div class="preview-node preview-initial">Initial State</div>
        <div class="preview-branches">
          <%= for pivot <- @pivots do %>
            <div class={"preview-branch preview-branch-#{pivot.icon}"}>
              <span class="preview-arrow">&rarr;</span>
              <div class="preview-node">
                <%= if String.length(pivot.title) > 25,
                  do: String.slice(pivot.title, 0, 22) <> "...",
                  else: pivot.title %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <div class="designer-actions">
      <button type="button" class="btn-secondary" phx-click="reset_designer">Reset Form</button>
      <button type="submit" id="create-adaptive-patient-btn">
        <%= if @editing_agent_id, do: "Update Patient", else: "Create Adaptive Patient" %>
      </button>
    </div>
  </form>
</section>

<%!-- Existing Agents Tab --%>
<section id="existing-tab" class={"tab-content #{if @active_tab == "existing", do: "active"}"}>
  <h2>Your Patients</h2>
  <div class="agents-list">
    <%= if Enum.empty?(@agents) do %>
      <p>No agents found. Create one first!</p>
    <% else %>
      <%= for agent <- @agents do %>
        <div class="agent-card">
          <div class="agent-card-info">
            <h4><%= agent["name"] || "Unnamed Agent" %></h4>
            <p>ID: <%= agent["agent_id"] %></p>
          </div>
          <div class="agent-card-actions">
            <button class="btn-edit" phx-click="edit_agent" phx-value-id={agent["agent_id"]}>
              Edit
            </button>
            <button
              phx-click="select_agent"
              phx-value-id={agent["agent_id"]}
              phx-value-name={agent["name"] || "Unnamed Agent"}
            >
              Select
            </button>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</section>

<%!-- Voice Library Modal --%>
<%= if @show_voice_library do %>
  <div class="modal" phx-click="close_voice_library">
    <div class="modal-content modal-large" phx-click-away="close_voice_library">
      <div class="modal-header">
        <h2>Voice Library</h2>
        <button class="modal-close" phx-click="close_voice_library">&times;</button>
      </div>
      <div class="voice-library-content">
        <form phx-submit="search_voice_library" class="voice-search">
          <input
            type="text"
            name="search"
            placeholder="Search voices (e.g., child, kid, boy, girl)..."
          />
          <select name="library_language">
            <%= for {label, value} <- @voice_library_languages do %>
              <option value={value}><%= label %></option>
            <% end %>
          </select>
          <select name="library_gender">
            <option value="">All Genders</option>
            <option value="male">Male</option>
            <option value="female">Female</option>
            <option value="neutral">Neutral</option>
          </select>
          <button type="submit">Search</button>
        </form>
        <div class="voice-suggestions">
          Quick:
          <button type="button" class="chip" phx-click="quick_search" phx-value-term="child">
            Child
          </button>
          <button type="button" class="chip" phx-click="quick_search" phx-value-term="kid">
            Kid
          </button>
          <button type="button" class="chip" phx-click="quick_search" phx-value-term="boy">
            Boy
          </button>
          <button type="button" class="chip" phx-click="quick_search" phx-value-term="girl">
            Girl
          </button>
          <button type="button" class="chip" phx-click="quick_search" phx-value-term="teen">
            Teen
          </button>
          <button type="button" class="chip" phx-click="quick_search" phx-value-term="young">
            Young
          </button>
        </div>
        <div class="voice-library-results">
          <%= if Enum.empty?(@voice_library_results) do %>
            <p>Search for voices above to browse the library.</p>
          <% else %>
            <%= for voice <- @voice_library_results do %>
              <div class="voice-library-card">
                <div class="voice-library-info">
                  <h4><%= voice.name %></h4>
                  <p><%= voice.description || "No description" %></p>
                  <div class="voice-meta">
                    <%= if voice.category do %>
                      <span class="voice-tag"><%= voice.category %></span>
                    <% end %>
                    <%= if voice.labels["language"] do %>
                      <span class="voice-tag">
                        <%= String.upcase(voice.labels["language"]) %>
                      </span>
                    <% end %>
                    <%= if voice.labels["gender"] do %>
                      <span class="voice-tag"><%= voice.labels["gender"] %></span>
                    <% end %>
                    <%= if voice.labels["age"] do %>
                      <span class="voice-tag"><%= voice.labels["age"] %></span>
                    <% end %>
                    <%= if voice.labels["accent"] do %>
                      <span class="voice-tag"><%= voice.labels["accent"] %></span>
                    <% end %>
                  </div>
                </div>
                <div class="voice-library-actions">
                  <button
                    class="btn-preview btn-preview-lib"
                    phx-hook="VoicePreviewUrl"
                    id={"preview-lib-#{voice.voice_id}"}
                    data-url={voice.preview_url}
                  >
                    &#9654;
                  </button>
                  <button
                    phx-click="add_voice_from_library"
                    phx-value-owner_id={voice.public_owner_id}
                    phx-value-voice_id={voice.voice_id}
                    phx-value-name={voice.name}
                  >
                    Add
                  </button>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>

<%!-- Edit Agent Modal --%>
<%= if @show_edit_modal && @edit_agent do %>
  <div class="modal" phx-click="close_edit_modal">
    <div class="modal-content" phx-click-away="close_edit_modal">
      <div class="modal-header">
        <h2>Edit Patient</h2>
        <button class="modal-close" phx-click="close_edit_modal">&times;</button>
      </div>
      <form phx-submit="save_agent" id="edit-form">
        <input type="hidden" name="agent_id" value={@edit_agent["agent_id"]} />

        <div class="form-group">
          <label for="edit_name">Patient Name</label>
          <input
            type="text"
            name="edit_name"
            id="edit_name"
            value={@edit_agent["name"]}
            placeholder="My Custom Agent"
          />
        </div>

        <div class="form-group">
          <label for="edit_prompt">System Prompt</label>
          <textarea name="edit_prompt" id="edit_prompt" rows="6" placeholder="You are a helpful assistant..."><%= get_in(@edit_agent, ["conversation_config", "agent", "prompt", "prompt"]) || "" %></textarea>
        </div>

        <div class="form-group">
          <label for="edit_first_message">First Message</label>
          <input
            type="text"
            name="edit_first_message"
            id="edit_first_message"
            value={get_in(@edit_agent, ["conversation_config", "agent", "first_message"]) || ""}
            placeholder="Hello! How can I help you today?"
          />
        </div>

        <div class="form-group">
          <label for="edit_voice_id">Voice</label>
          <div class="voice-select-wrapper">
            <select name="edit_voice_id" id="edit_voice_id">
              <%= for voice <- @voices do %>
                <option
                  value={voice.voice_id}
                  selected={
                    voice.voice_id ==
                      get_in(@edit_agent, ["conversation_config", "tts", "voice_id"])
                  }
                >
                  <%= voice.name %> (<%= voice.category || "custom" %>)
                </option>
              <% end %>
            </select>
            <button
              type="button"
              class="btn-preview"
              phx-hook="VoicePreview"
              id="edit-preview-voice-btn"
              data-select="edit_voice_id"
              title="Preview voice"
            >
              &#9654;
            </button>
            <button
              type="button"
              class="btn-browse"
              phx-click="open_voice_library"
              phx-value-target="edit_voice_id"
              title="Browse Voice Library"
            >
              &#128269;
            </button>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="edit_language">Language</label>
            <select name="edit_language" id="edit_language">
              <%= for {label, value} <- @languages do %>
                <option
                  value={value}
                  selected={
                    value ==
                      (get_in(@edit_agent, ["conversation_config", "agent", "language"]) || "en")
                  }
                >
                  <%= label %>
                </option>
              <% end %>
            </select>
          </div>
        </div>

        <div class="modal-actions">
          <button type="button" class="btn-secondary" phx-click="close_edit_modal">Cancel</button>
          <button
            type="button"
            class="btn-danger"
            phx-click="delete_agent"
            phx-value-id={@edit_agent["agent_id"]}
            data-confirm="Are you sure you want to delete this agent? This action cannot be undone."
          >
            Delete Agent
          </button>
          <button type="submit">Save Changes</button>
        </div>
      </form>
    </div>
  </div>
<% end %>

<%!-- Conversation Section --%>
<%= if @show_conversation do %>
  <section class="conversation-section" id="conversation-section" phx-hook="Conversation">
    <h2>Conversation</h2>
    <p id="active-agent">
      Agent: <span><%= @current_agent_name || "None selected" %></span>
    </p>

    <div class="controls">
      <div class="buttons">
        <button
          id="start-btn"
          phx-click="conversation_log"
          phx-value-message="starting"
          data-agent-id={@current_agent_id}
        >
          Start Conversation
        </button>
        <button id="stop-btn" disabled>Stop Conversation</button>
      </div>
      <p class="status" id="status">Status: <%= @conversation_status %></p>
    </div>

    <div>
      <h3>Events</h3>
      <div id="log" class="log">
        <%= for entry <- @log_entries do %>
          <div class="log-entry" id={"log-#{entry.id}"}>
            [<%= entry.time %>] <%= entry.message %>
          </div>
        <% end %>
      </div>
    </div>
  </section>
<% end %>
